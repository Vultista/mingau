//Componentes:
Arduino Uno
Teclado Matricial (4x4)
Display LCD (opcional, mas recomendado para exibir os resultados)
Jumpers e uma protoboard


#include <Keypad.h>
#include <LiquidCrystal.h>

// Configuração do teclado matricial
const byte ROWS = 4; // Quatro linhas
const byte COLS = 4; // Quatro colunas
char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};
byte rowPins[ROWS] = {9, 8, 7, 6}; // Pinos das linhas
byte colPins[COLS] = {5, 4, 3, 2}; // Pinos das colunas
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// Configuração do LCD (opcional)
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

float num1 = 0;
float num2 = 0;
char operation = ' ';

void setup() {
    // Inicializa o LCD
    lcd.begin(16, 2);
    lcd.print("Calculadora");
}

void loop() {
    char key = keypad.getKey();

    if (key) {
        if (key >= '0' && key <= '9') {
            // Se um número é pressionado
            if (operation == ' ') {
                num1 = num1 * 10 + (key - '0'); // Forma o primeiro número
                lcd.setCursor(0, 1);
                lcd.print(num1);
            } else {
                num2 = num2 * 10 + (key - '0'); // Forma o segundo número
                lcd.setCursor(0, 1);
                lcd.print(num2);
            }
        } else if (key == 'A') { // Adição
            operation = '+';
            lcd.setCursor(0, 0);
            lcd.print("Adicao");
        } else if (key == 'B') { // Subtração
            operation = '-';
            lcd.setCursor(0, 0);
            lcd.print("Subtracao");
        } else if (key == 'C') { // Multiplicação
            operation = '*';
            lcd.setCursor(0, 0);
            lcd.print("Multiplicacao");
        } else if (key == 'D') { // Divisão
            operation = '/';
            lcd.setCursor(0, 0);
            lcd.print("Divisao");
        } else if (key == '#') { // Calcular resultado
            float result = calculate(num1, num2, operation);
            lcd.clear();
            lcd.setCursor(0, 0);
            lcd.print("Resultado:");
            lcd.setCursor(0, 1);
            lcd.print(result);

            // Resetar os valores
            num1 = 0;
            num2 = 0;
            operation = ' ';
            delay(3000);
            lcd.clear();
            lcd.print("Calculadora");
        } else if (key == '*') { // Limpar
            num1 = 0;
            num2 = 0;
            operation = ' ';
            lcd.clear();
            lcd.print("Calculadora");
        }
    }
}

float calculate(float n1, float n2, char op) {
    switch (op) {
        case '+':
            return n1 + n2;
        case '-':
            return n1 - n2;
        case '*':
            return n1 * n2;
        case '/':
            if (n2 != 0) return n1 / n2;
            else return 0; // Divisão por zero
        default:
            return 0;
    }
}
